<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>PixelOfficial.com — Pixel Art Reels & Bozor</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Pixel-Art Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Silkscreen:wght@400;700&family=VT323&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        'pixel-title': ['"Press Start 2P"', 'monospace'],
                        'pixel-ui': ['"Silkscreen"', 'monospace'],
                        'pixel-body': ['"VT323"', 'monospace'],
                    },
                    colors: {
                        'px-bg': '#2c3e50',
                        'px-cream': '#f7f1e3',
                        'px-card': '#fff8e7',
                        'px-dark': '#1e1b18',
                        'px-terracotta': '#d9534f',
                        'px-terracotta-dark': '#b52b27',
                        'px-sky': '#5bc0de',
                        'px-sky-dark': '#31b0d5',
                        'px-gold': '#f0ad4e',
                        'px-green': '#5cb85c',
                        'px-green-dark': '#449d44',
                        'px-purple': '#9b59b6',
                    }
                }
            }
        }
    </script>

    <style>
        /* Retro Pixel-Art Custom Styles */
        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: #23272e;
            background-image: 
                radial-gradient(#343a46 2px, transparent 2px),
                radial-gradient(#343a46 2px, #23272e 2px);
            background-size: 32px 32px;
            background-position: 0 0, 16px 16px;
            font-family: 'Silkscreen', monospace;
            color: #1e1b18;
            margin: 0;
            padding: 0;
            overflow: hidden;
            height: 100dvh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* Crisp Pixel Borders & Shadows */
        .pixel-box {
            border: 4px solid #1e1b18;
            box-shadow: 4px 4px 0px #1e1b18;
            border-radius: 4px;
        }

        .pixel-box-sm {
            border: 3px solid #1e1b18;
            box-shadow: 3px 3px 0px #1e1b18;
            border-radius: 4px;
        }

        .pixel-btn {
            border: 3px solid #1e1b18;
            box-shadow: 0 4px 0 #1e1b18;
            transition: transform 0.08s ease, box-shadow 0.08s ease;
            cursor: pointer;
            user-select: none;
            border-radius: 4px;
        }

        .pixel-btn:active {
            transform: translateY(4px);
            box-shadow: 0 0px 0 #1e1b18;
        }

        .pixel-input {
            border: 3px solid #1e1b18;
            background-color: #ffffff;
            box-shadow: inset 3px 3px 0px rgba(30, 27, 24, 0.12);
            outline: none;
            border-radius: 4px;
        }

        .pixel-input:focus {
            background-color: #fffdf5;
            border-color: #d9534f;
        }

        /* Pixelated Image Rendering */
        .pixel-art-img {
            image-rendering: pixelated;
            image-rendering: crisp-edges;
        }

        /* Reels Snap Scrolling Container */
        .reels-container {
            scroll-snap-type: y mandatory;
            overflow-y: scroll;
            height: 100%;
            scrollbar-width: none; /* Firefox */
            -ms-overflow-style: none;  /* IE and Edge */
        }
        .reels-container::-webkit-scrollbar {
            display: none; /* Chrome, Safari, Opera */
        }

        .reel-item {
            scroll-snap-align: start;
            scroll-snap-stop: always;
            height: 100%;
            width: 100%;
            flex-shrink: 0;
        }

        /* Custom Scrollbar for Profile & Forms */
        .custom-scroll::-webkit-scrollbar {
            width: 8px;
        }
        .custom-scroll::-webkit-scrollbar-track {
            background: #e6dec8;
            border-left: 2px solid #1e1b18;
        }
        .custom-scroll::-webkit-scrollbar-thumb {
            background: #d9534f;
            border: 2px solid #1e1b18;
        }

        /* Rainbow Pixel Banner Effect inspired by PixelOfficial.com */
        .pixel-banner-grad {
            background: linear-gradient(90deg, #ff7675, #fdcb6e, #55efc4, #74b9ff, #a29bfe);
        }

        @keyframes floatPixel {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-4px); }
        }
        .animate-pixel-float {
            animation: floatPixel 2.5s ease-in-out infinite;
        }
    </style>
</head>
<body>

    <!-- Main Mobile-First App Frame -->
    <div id="app-shell" class="relative w-full h-full sm:w-[440px] sm:h-[92dvh] sm:max-h-[840px] bg-px-cream sm:border-4 sm:border-px-dark sm:shadow-[8px_8px_0px_#1e1b18] sm:rounded-lg flex flex-col overflow-hidden">
        
        <!-- Top Header Bar -->
        <header class="bg-px-card border-b-4 border-px-dark px-3 py-2.5 flex items-center justify-between z-20 shrink-0">
            <div class="flex items-center gap-2 cursor-pointer" onclick="switchTab('reels')">
                <!-- Mini Pixel House Icon -->
                <div class="w-8 h-8 bg-px-terracotta border-2 border-px-dark flex items-center justify-center shadow-[2px_2px_0px_#1e1b18] rounded-sm">
                    <svg class="w-5 h-5 text-white" viewBox="0 0 16 16" fill="currentColor">
                        <path d="M8 1L1 7h2v7h4v-4h2v4h4V7h2L8 1z"/>
                    </svg>
                </div>
                <div>
                    <h1 class="font-pixel-title text-[11px] sm:text-xs tracking-tight text-px-dark leading-none">
                        Pixel<span class="text-px-terracotta">Official</span>.com
                    </h1>
                    <span class="text-[10px] text-stone-600 font-pixel-ui block mt-0.5">CREATIVE HUB & REELS</span>
                </div>
            </div>

            <!-- User Coins / Info Button -->
            <div class="flex items-center gap-2">
                <div id="header-balance-badge" class="hidden bg-px-gold/30 border-2 border-px-dark px-2 py-1 rounded text-xs font-bold flex items-center gap-1">
                    <span>🪙</span>
                    <span id="header-coins">0</span>
                </div>
                <button onclick="toggleInfoModal(true)" title="GitHub Pages & Saqlash haqida" class="pixel-btn bg-px-sky text-px-dark px-2 py-1 text-xs font-bold">
                    ?
                </button>
            </div>
        </header>

        <!-- Toast Notification Banner (Replaces alert()) -->
        <div id="toast-box" class="hidden absolute top-16 left-1/2 -translate-x-1/2 z-50 w-[90%] max-w-[380px] pixel-box bg-px-gold text-px-dark px-3 py-2.5 text-xs font-bold text-center transition-all">
            <span id="toast-message">Xabar</span>
        </div>

        <!-- MAIN CONTENT AREA -->
        <main class="flex-1 relative overflow-hidden bg-[#181614]">
            
            <!-- ==================== 1. REELS VIEW ==================== -->
            <section id="view-reels" class="w-full h-full relative">
                <div id="reels-feed" class="reels-container">
                    <!-- Reels cards injected dynamically via JS -->
                </div>

                <!-- Scroll Hint Pill -->
                <div id="scroll-hint" class="pointer-events-none absolute top-3 right-3 bg-px-dark/80 text-px-cream border-2 border-px-cream/40 px-2 py-1 rounded text-[10px] flex items-center gap-1 z-10">
                    <span>↕ Pastga suring</span>
                </div>
            </section>

            <!-- ==================== 2. SELL / UPLOAD VIEW ==================== -->
            <section id="view-sell" class="hidden w-full h-full bg-px-cream overflow-y-auto custom-scroll p-4">
                <div class="pixel-box bg-px-card p-4 mb-4">
                    <div class="pixel-banner-grad border-2 border-px-dark px-2 py-1 mb-3 text-center">
                        <h2 class="font-pixel-title text-xs text-px-dark">YANGI PIXEL RASM SOTISH</h2>
                    </div>
                    <p class="text-xs text-stone-700 mb-3 leading-relaxed">
                        O'zingiz chizgan piksel rasmning <b>HTTP/HTTPS</b> havolasini (linkini) kiriting va narx belgilang. Rasm darhol <b>Reels</b> lentasida ko'rinadi!
                    </p>

                    <!-- Auth Warning if not logged in -->
                    <div id="sell-auth-warning" class="hidden bg-px-terracotta/15 border-2 border-px-terracotta p-3 rounded mb-3 text-center">
                        <p class="text-xs font-bold text-px-terracotta-dark mb-2">Rasm joylash uchun avval akkauntga kiring yoki ro'yxatdan o'ting!</p>
                        <button onclick="switchTab('profile')" class="pixel-btn bg-px-terracotta text-white px-4 py-2 text-xs font-bold">
                            Akkauntga kirish →
                        </button>
                    </div>

                    <!-- Sell Form -->
                    <form id="sell-form" onsubmit="handlePublishArtwork(event)" class="space-y-3">
                        <div>
                            <label class="block text-xs font-bold mb-1">Rasm HTTP / HTTPS Linki *</label>
                            <div class="flex gap-1.5">
                                <input type="text" id="art-url" required placeholder="https://example.com/my-pixel-art.png" oninput="previewArtUrl(this.value)" class="pixel-input w-full px-2.5 py-2 text-xs">
                                <button type="button" onclick="fillRandomSampleArt()" title="Namuna rasm linkini qo'yish" class="pixel-btn bg-px-sky text-px-dark px-2.5 py-1 text-[10px] font-bold shrink-0">
                                    🎲 Namuna
                                </button>
                            </div>
                        </div>

                        <!-- Live Image Preview Box -->
                        <div class="border-3 border-dashed border-px-dark bg-stone-200 h-44 rounded flex flex-col items-center justify-center overflow-hidden relative">
                            <img id="art-preview-img" src="" alt="Oldindan ko'rish" class="hidden w-full h-full object-contain pixel-art-img bg-[#1e1b18]">
                            <div id="art-preview-placeholder" class="text-center p-3">
                                <span class="text-2xl block mb-1">🖼️</span>
                                <span class="text-[11px] text-stone-600">Rasm linkini kiritsangiz, shu yerda ko'rinadi</span>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-2.5">
                            <div>
                                <label class="block text-xs font-bold mb-1">Rasm Nomi *</label>
                                <input type="text" id="art-title" required maxlength="32" placeholder="Masalan: Kiber Samarqand" class="pixel-input w-full px-2.5 py-2 text-xs">
                            </div>
                            <div>
                                <label class="block text-xs font-bold mb-1">Narxi (Tanga 🪙) *</label>
                                <input type="number" id="art-price" required min="1" max="999999" value="150" class="pixel-input w-full px-2.5 py-2 text-xs">
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-bold mb-1">Qisqacha Tavsif</label>
                            <textarea id="art-desc" rows="2" maxlength="120" placeholder="Rasm haqida qisqacha yozing..." class="pixel-input w-full px-2.5 py-2 text-xs resize-none"></textarea>
                        </div>

                        <button type="submit" id="sell-submit-btn" class="pixel-btn w-full bg-px-green text-white py-3 text-xs font-bold tracking-wide uppercase">
                            🚀 Sotuvga va Reels'ga Chiqarish
                        </button>
                    </form>
                </div>
            </section>

            <!-- ==================== 3. PROFILE & AUTH VIEW ==================== -->
            <section id="view-profile" class="hidden w-full h-full bg-px-cream overflow-y-auto custom-scroll p-4">
                
                <!-- A. GUEST VIEW (Login / Register Tabs) -->
                <div id="auth-container" class="pixel-box bg-px-card p-4">
                    <div class="text-center mb-4">
                        <div class="inline-block bg-px-terracotta text-white px-3 py-1 border-2 border-px-dark text-[10px] font-pixel-title mb-2">
                            PIXELOFFICIAL HUB
                        </div>
                        <h2 class="text-sm font-bold">Xush kelibsiz, Rassom!</h2>
                        <p class="text-xs text-stone-600 mt-1">Akkaunt oching, rasmlaringizni soting va profilingizni sozlang.</p>
                    </div>

                    <!-- Switch Login / Register -->
                    <div class="grid grid-cols-2 gap-2 mb-4">
                        <button type="button" id="tab-btn-register" onclick="switchAuthMode('register')" class="pixel-btn bg-px-gold text-px-dark py-2 text-xs font-bold">
                            Ro'yxatdan o'tish
                        </button>
                        <button type="button" id="tab-btn-login" onclick="switchAuthMode('login')" class="pixel-btn bg-stone-200 text-px-dark py-2 text-xs font-bold">
                            Kirish (Login)
                        </button>
                    </div>

                    <!-- REGISTER FORM -->
                    <form id="register-form" onsubmit="handleRegister(event)" class="space-y-3">
                        <div>
                            <label class="block text-xs font-bold mb-1">Akkaunt Nomi (Username) *</label>
                            <input type="text" id="reg-username" required minlength="3" maxlength="20" placeholder="Masalan: AzamatPixel" class="pixel-input w-full px-2.5 py-2 text-xs">
                        </div>

                        <div>
                            <label class="block text-xs font-bold mb-1">Parol *</label>
                            <input type="password" id="reg-password" required minlength="3" placeholder="••••••" class="pixel-input w-full px-2.5 py-2 text-xs">
                        </div>

                        <div>
                            <label class="block text-xs font-bold mb-1">Davlatingiz *</label>
                            <select id="reg-country" class="pixel-input w-full px-2.5 py-2 text-xs">
                                <option value="🇺🇿 O'zbekiston">🇺🇿 O'zbekiston</option>
                                <option value="🇰🇿 Qozog'iston">🇰🇿 Qozog'iston</option>
                                <option value="🇰🇬 Qirg'iziston">🇰🇬 Qirg'iziston</option>
                                <option value="🇹🇯 Tojikiston">🇹🇯 Tojikiston</option>
                                <option value="🇹🇷 Turkiya">🇹🇷 Turkiya</option>
                                <option value="🇺🇸 AQSH">🇺🇸 AQSH</option>
                                <option value="🇯🇵 Yaponiya">🇯🇵 Yaponiya</option>
                                <option value="🇰🇷 Janubiy Koreya">🇰🇷 Janubiy Koreya</option>
                                <option value="🌍 Boshqa davlat">🌍 Boshqa davlat</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-xs font-bold mb-1">Profil Rasmi (HTTP Link yoki tanlang)</label>
                            <input type="text" id="reg-avatar" placeholder="https://... (bo'sh qolsa piksel avatar beriladi)" class="pixel-input w-full px-2.5 py-2 text-xs mb-2">
                            
                            <!-- Preset Pixel Avatars -->
                            <div class="flex items-center justify-between gap-1 bg-stone-200 p-1.5 border-2 border-px-dark rounded">
                                <span class="text-[10px] font-bold px-1">Tayyor:</span>
                                <div id="reg-avatar-presets" class="flex gap-1.5"></div>
                            </div>
                        </div>

                        <button type="submit" class="pixel-btn w-full bg-px-green text-white py-2.5 text-xs font-bold mt-2">
                            ✨ Akkaunt Yaratish (+500 🪙 Bonus)
                        </button>
                    </form>

                    <!-- LOGIN FORM -->
                    <form id="login-form" onsubmit="handleLogin(event)" class="hidden space-y-3">
                        <div>
                            <label class="block text-xs font-bold mb-1">Akkaunt Nomi (Username)</label>
                            <input type="text" id="login-username" required placeholder="Akkaunt nomingiz" class="pixel-input w-full px-2.5 py-2 text-xs">
                        </div>
                        <div>
                            <label class="block text-xs font-bold mb-1">Parol</label>
                            <input type="password" id="login-password" required placeholder="Parolingiz" class="pixel-input w-full px-2.5 py-2 text-xs">
                        </div>
                        <button type="submit" class="pixel-btn w-full bg-px-sky text-px-dark py-2.5 text-xs font-bold">
                            🔑 Tizimga Kirish
                        </button>

                        <div class="bg-stone-200 border-2 border-px-dark p-2 rounded text-[11px] text-stone-700">
                            <b>Tezkor sinov uchun demo akkaunt:</b><br>
                            Login: <code class="bg-white px-1 border border-px-dark">SardorArt</code> | Parol: <code class="bg-white px-1 border border-px-dark">123</code>
                        </div>
                    </form>
                </div>

                <!-- B. LOGGED-IN PROFILE DASHBOARD -->
                <div id="user-dashboard" class="hidden space-y-4">
                    <!-- Profile Header Card -->
                    <div class="pixel-box bg-px-card p-4 relative">
                        <div class="flex items-start gap-3">
                            <img id="prof-avatar" src="" alt="Avatar" class="w-16 h-16 border-3 border-px-dark bg-stone-800 object-cover pixel-art-img shrink-0 shadow-[3px_3px_0px_#1e1b18]">
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center justify-between gap-1">
                                    <h2 id="prof-username" class="font-bold text-base truncate text-px-dark">Username</h2>
                                    <button onclick="handleLogout()" class="pixel-btn bg-px-terracotta text-white px-2 py-1 text-[10px] font-bold shrink-0">
                                        Chiqish
                                    </button>
                                </div>
                                <p id="prof-country" class="text-xs text-stone-700 font-bold mt-0.5">🇺🇿 O'zbekiston</p>
                                <div class="mt-2 inline-flex items-center gap-1.5 bg-px-gold/40 border-2 border-px-dark px-2 py-0.5 rounded text-xs font-bold">
                                    <span>Balans:</span>
                                    <span id="prof-coins">500</span> <span>🪙</span>
                               
